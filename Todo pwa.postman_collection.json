{
	"info": {
		"_postman_id": "601c9f6a-8c91-3c98-350c-c860ce1614de",
		"name": "Todo PWA (Neon)",
		"description": "Netlify Functions API collection for Todo List PWA backed by Neon PostgreSQL.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "url",
			"value": "http://localhost:8888",
			"type": "string"
		},
		{
			"key": "x-auth-token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "signup",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.response.code === 200) {",
							"    const json = pm.response.json();",
							"    if (json.token) {",
							"        pm.collectionVariables.set('x-auth-token', json.token);",
							"    }",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPassword123!\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/.netlify/functions/signup",
					"host": [
						"{{url}}"
					],
					"path": [
						".netlify",
						"functions",
						"signup"
					]
				},
				"description": "Register a new user and return a JWT token (auto-saved to x-auth-token collection variable)."
			},
			"response": []
		},
		{
			"name": "auth",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.response.code === 200) {",
							"    const json = pm.response.json();",
							"    if (json.token) {",
							"        pm.collectionVariables.set('x-auth-token', json.token);",
							"    }",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPassword123!\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/.netlify/functions/auth",
					"host": [
						"{{url}}"
					],
					"path": [
						".netlify",
						"functions",
						"auth"
					]
				},
				"description": "Authenticate an existing user and return a JWT token (auto-saved to x-auth-token collection variable)."
			},
			"response": []
		},
		{
			"name": "getTodos",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-auth-token",
						"value": "{{x-auth-token}}"
					}
				],
				"url": {
					"raw": "{{url}}/.netlify/functions/getTodos",
					"host": [
						"{{url}}"
					],
					"path": [
						".netlify",
						"functions",
						"getTodos"
					]
				},
				"description": "Fetch all todos for the authenticated user, keyed by uid."
			},
			"response": []
		},
		{
			"name": "createTodo",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-auth-token",
						"value": "{{x-auth-token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"uid\": \"todo-1001\",\n  \"todo\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"status\": false,\n  \"date\": \"2026-11-22T12:00:00.000Z\",\n  \"priority\": \"P1\",\n  \"comments\": [\n    \"Check discounts\"\n  ],\n  \"reminders\": [\n    \"2026-11-23T09:00:00.000Z\"\n  ]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/.netlify/functions/createTodo",
					"host": [
						"{{url}}"
					],
					"path": [
						".netlify",
						"functions",
						"createTodo"
					]
				},
				"description": "Create a new top-level todo."
			},
			"response": []
		},
		{
			"name": "addSubTodo",
			"request": {
				"method": "POST",
				"header": [
