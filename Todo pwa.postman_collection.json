					],
					"path": [
						".netlify",
						"functions",
						"updateTodo"
					]
				},
				"description": "Update an existing todo or sub-todo owned by the authenticated user."
			},
			"response": []
		},
		{
			"name": "updateRemindersList",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"uid\": \"todo-1001\",\n  \"reminder\": \"2026-11-23T09:00:00.000Z\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/.netlify/functions/updateRemindersList",
					"host": [
						"{{url}}"
					],
					"path": [
						".netlify",
						"functions",
						"updateRemindersList"
					]
				},
				"description": "Remove a specific reminder timestamp from a todo's reminders array."
			},
			"response": []
		},
		{
			"name": "deleteTodo",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "x-auth-token",
						"value": "{{x-auth-token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": \"todo-1001\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/.netlify/functions/deleteTodo",
					"host": [
						"{{url}}"
					],
					"path": [
						".netlify",
						"functions",
						"deleteTodo"
					]
				},
				"description": "Delete a todo by uid (automatically cascades to all nested sub-todos via ON DELETE CASCADE)."
			},
			"response": []
		}
	]
