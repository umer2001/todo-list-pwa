						"key": "x-auth-token",
						"value": "{{x-auth-token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"parentId\": \"todo-1001\",\n  \"newTodo\": {\n    \"uid\": \"subtodo-1002\",\n    \"todo\": \"Buy organic milk\",\n    \"description\": \"\",\n    \"status\": true,\n    \"date\": \"2026-11-22T12:05:00.000Z\",\n    \"priority\": \"P2\",\n    \"comments\": [],\n    \"reminders\": []\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/.netlify/functions/addSubTodo",
					"host": [
						"{{url}}"
					],
					"path": [
						".netlify",
						"functions",
						"addSubTodo"
					]
				},
				"description": "Create a sub-todo attached to an existing parent todo (parentId = parent's uid)."
			},
			"response": []
		},
		{
			"name": "updateTodo",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "x-auth-token",
						"value": "{{x-auth-token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"uid\": \"todo-1001\",\n  \"todo\": \"Buy groceries (updated)\",\n  \"description\": \"Milk, eggs, bread, coffee\",\n  \"status\": false,\n  \"date\": \"2026-11-22T12:00:00.000Z\",\n  \"priority\": \"P2\",\n  \"comments\": [\n    \"Check discounts\",\n    \"Added coffee\"\n  ],\n  \"reminders\": [\n    \"2026-11-23T09:00:00.000Z\"\n  ]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/.netlify/functions/updateTodo",
					"host": [
