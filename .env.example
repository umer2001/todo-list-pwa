# Neon PostgreSQL connection string (from Neon Console -> Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Secret key for signing JWT authentication tokens
JWT_SECRET=change_me_to_a_long_random_secret

# Frontend environment: development or production
REACT_APP_ENVIRONMENT=development

# App mode: normal or guest
REACT_APP_MODE=normal

# Required only when REACT_APP_MODE=guest
REACT_APP_GUEST_EMAIL=guest@example.com
REACT_APP_GUEST_PASSWORD=change_me

